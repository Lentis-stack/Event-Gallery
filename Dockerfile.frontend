# ============================================================
# Lentis Gallery — Frontend Production Dockerfile
# ============================================================
# Multi-stage build:
#   Stage 1: Node build (install deps + build React app)
#   Stage 2: nginx serve (minimal static file server)
#
# This container also acts as the REVERSE PROXY for /api/
# requests, routing them to the backend container.
#
# Usage:
#   docker build -t lentis-frontend --build-arg VITE_PUBLIC_URL=https://lentis.gallery .
# ============================================================

# ---- Stage 1: Build ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first for better layer caching
COPY package.json package-lock.json ./

# Install all dependencies (including dev for build tools)
# Retry once to handle transient ETXTBSY on esbuild (Docker/WSL2)
RUN npm ci || (sleep 2 && npm ci)

# Copy source code
COPY . .

# Build argument for VITE_PUBLIC_URL (embedded at build time)
ARG VITE_PUBLIC_URL=""

# Build the production bundle
RUN VITE_PUBLIC_URL="$VITE_PUBLIC_URL" npm run build


# ---- Stage 2: Production serve (nginx as SPA + reverse proxy) ----
FROM nginx:1.27-alpine AS production

# Copy the built application
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration (serves SPA + proxies /api to backend)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the runtime env injection script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:80/api/health || exit 1

# Entrypoint injects runtime env vars then starts nginx
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
