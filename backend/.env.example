# ============================================================
# Lentis Gallery — Backend Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit the real `.env` (it contains secrets).
#
# ============================================================
# ENVIRONMENT MODES
# ============================================================
#
# DEVELOPMENT (default):
#   - Allows insecure defaults (localhost, weak secrets)
#   - Warns loudly but starts successfully
#   - Local storage, local Redis, local PostgreSQL
#
# PRODUCTION (ENVIRONMENT=production):
#   - REJECTS insecure defaults at startup
#   - Requires explicit configuration for all services
#   - Fails fast with clear error messages if misconfigured
#
# ============================================================

# --- Application ---
APP_NAME=Lentis Gallery API
ENVIRONMENT=development
DEBUG=true

# --- Security (REQUIRED in production) ---
# Generate strong secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login rate-limiting / lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# --- Database (REQUIRED in production) ---
# Production example with SSL:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/lentis?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lentis_gallery

# --- CORS (REQUIRED in production) ---
# Comma-separated HTTPS origins. Production rejects wildcards.
# Example: https://lentis.gallery,https://admin.lentis.gallery
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- API Documentation ---
# Set to true ONLY for development. Disabled in production.
ENABLE_DOCS=false

# --- Rate Limiting ---
RATE_LIMIT_GUEST_REGISTRATION=10
RATE_LIMIT_EVENT_MEDIA_UPLOAD=30

# --- Request Limits ---
MAX_REQUEST_BODY_BYTES=629145600

# --- Guest sessions ---
GUEST_SESSION_EXPIRE_HOURS=6

# --- Media limits ---
MAX_PHOTOS_PER_EVENT=10000
MAX_VIDEOS_PER_EVENT=5000
MAX_IMAGE_SIZE_MB=30
MAX_VIDEO_SIZE_MB=500
MAX_EVENT_STORAGE_GB=50

# --- Storage provider ---
# "r2"   -> Cloudflare R2 (production)
# "local"-> Local filesystem (development/tests only)
STORAGE_PROVIDER=local

# Cloudflare R2 config (REQUIRED when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lentis-media
R2_ENDPOINT=

# Local filesystem storage (development only)
LOCAL_STORAGE_PATH=./storage

# --- Media processing ---
PROCESSING_MAX_RETRIES=3
IMAGE_OPTIMIZED_MAX_DIMENSION=2560
MAX_IMAGE_PIXELS=25000000
IMAGE_THUMBNAIL_MAX_DIMENSION=600
IMAGE_QUALITY=88
VIDEO_CRF=23
VIDEO_PRESET=medium
MAX_VIDEO_DURATION_SECONDS=1800
WORKER_CONCURRENCY=2
PROCESSING_TEMP_DIR=

# --- Background job queue (REQUIRED in production) ---
# Production: rediss://:password@host:6380/0
REDIS_URL=redis://localhost:6379/0
PROCESSING_QUEUE=media-processing
