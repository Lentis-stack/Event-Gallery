# ============================================================
# Lentis Gallery — Backend Environment Template
# ------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     Copy-Item .env.example .env     # Windows PowerShell
#     cp .env.example .env            # macOS / Linux
#
# NEVER commit the real `.env` (it contains secrets). This file is
# the safe template. All values have production-safe defaults.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=Lentis Gallery API
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------
# Security (Phase 2)
# ------------------------------------------------------------
SECRET_KEY=change-me
# MUST be a strong, unique secret (>=32 chars) in production.
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256

# ------------------------------------------------------------
# Token lifetimes (Phase 2)
# ------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login rate-limiting / lockout (Phase 2)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# ------------------------------------------------------------
# Database (Phase 1)
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lentis_gallery

# ------------------------------------------------------------
# CORS (Phase 1)
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------
# Guest sessions (Phase 4)
# ------------------------------------------------------------
GUEST_SESSION_EXPIRE_HOURS=6

# ------------------------------------------------------------
# Media limits (Phase 5)
# ------------------------------------------------------------
MAX_PHOTOS_PER_EVENT=3000
MAX_VIDEOS_PER_EVENT=500
MAX_IMAGE_SIZE_MB=30
MAX_VIDEO_SIZE_MB=500
MAX_EVENT_STORAGE_GB=50

# ------------------------------------------------------------
# Storage provider (Phase 5)
#   "r2"   -> Cloudflare R2 (production)
#   "local"-> Local filesystem (development/tests only)
# ------------------------------------------------------------
STORAGE_PROVIDER=local

# Cloudflare R2 config (production). Credentials MUST be real here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lentis-media
R2_ENDPOINT=

# Local-filesystem storage (dev/test only)
LOCAL_STORAGE_PATH=./storage

# ------------------------------------------------------------
# Media processing (Phase 6)
# ------------------------------------------------------------
# Max processing attempts before a job is marked FAILED.
PROCESSING_MAX_RETRIES=3
# Max display dimension (px) for the OPTIMIZED image variant.
IMAGE_OPTIMIZED_MAX_DIMENSION=2560
# Absolute cap on total pixels (width x height) — decompression-bomb guard.
MAX_IMAGE_PIXELS=25000000
# Max dimension (px) for the THUMBNAIL.
IMAGE_THUMBNAIL_MAX_DIMENSION=600
# JPEG/WebP quality for optimized derivatives (0-100).
IMAGE_QUALITY=88
# FFmpeg CRF for H.264 video encoding (lower = higher quality).
VIDEO_CRF=23
# FFmpeg preset (speed/size trade-off): ultrafast..veryslow.
VIDEO_PRESET=medium
# Reject videos longer than this many seconds during processing.
MAX_VIDEO_DURATION_SECONDS=1800
# How many jobs the RQ worker runs at once.
WORKER_CONCURRENCY=2
# Directory for temporary processing files (system temp if empty).
PROCESSING_TEMP_DIR=

# ------------------------------------------------------------
# Background job queue (Phase 6) — Redis + RQ
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
PROCESSING_QUEUE=media-processing
