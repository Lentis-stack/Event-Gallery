# ============================================================
# Lentis Gallery — Operator Credentials Template
# ============================================================
# Copy this file to .env.operator.local and fill in real values.
# NEVER commit .env.operator.local to Git.
# NEVER put real secrets in this template.
# ============================================================

# ---- Admin Login ----
# IMPORTANT: These values are REFERENCE ONLY.
# The backend does NOT read these variables.
# Actual credentials are in the PostgreSQL database.
# To change admin password, use:
#   docker exec -it gall-backend-1 python /scripts/manage_credentials.py \
#       --action reset-admin --email <email> --password "<password>"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Host Test Login ----
# IMPORTANT: These values are REFERENCE ONLY.
# Actual credentials are in the PostgreSQL database.
# To change host password, use manage_credentials.py or update the database directly.
HOST_EMAIL=
HOST_PASSWORD=

# ---- Test Event ----
TEST_EVENT_NAME=
TEST_EVENT_SLUG=
TEST_EVENT_ID=

# ---- Production Domain ----
PRODUCTION_DOMAIN=
FRONTEND_URL=
VITE_PUBLIC_URL=

# ---- Database ----
# Example: postgresql+psycopg://lentis:YOUR_PASSWORD@db-host:5432/lentis_gallery
DATABASE_URL=

# ---- Redis ----
# Example: redis://:YOUR_PASSWORD@redis-host:6379/0
REDIS_URL=

# ---- R2 Object Storage ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# ---- Secrets ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
SECRET_KEY=

# ---- Docker ----
# Password for PostgreSQL container
POSTGRES_PASSWORD=
# Password for Redis container
REDIS_PASSWORD=
