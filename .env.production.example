# ============================================================
# Lentis Gallery — Production Environment Template
# ============================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production with real secrets.
#
# Quick start:
#   1. cp .env.production.example .env.production
#   2. Fill in ALL required values below
#   3. docker compose --env-file .env.production up -d --build
#   4. docker compose exec backend alembic upgrade head
#   5. curl http://localhost/api/health
# ============================================================

# ============================================================
# REQUIRED — Application
# ============================================================
ENVIRONMENT=production
DEBUG=false
APP_NAME="Lentis Gallery API"

# ============================================================
# REQUIRED — Security Secrets
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================
SECRET_KEY=
JWT_SECRET_KEY=

# ============================================================
# REQUIRED — Database
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# NOTE: Inside Docker Compose, use "postgres" as the hostname.
# ============================================================
POSTGRES_DB=lentis_gallery
POSTGRES_USER=lentis
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://lentis:YOUR_POSTGRES_PASSWORD@postgres:5432/lentis_gallery

# ============================================================
# REQUIRED — Redis
# ============================================================
REDIS_PASSWORD=
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0

# ============================================================
# REQUIRED — Frontend URL (CORS origins, comma-separated)
# Must match your production domain(s). Use HTTPS.
# Example: https://lentis.gallery,https://www.lentis.gallery
# ============================================================
FRONTEND_URL=
VITE_PUBLIC_URL=

# ============================================================
# REQUIRED — Cloudflare R2 Storage (production)
# ============================================================
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lentis-media
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ============================================================
# OPTIONAL — API Documentation (disabled in production)
# Set ENABLE_DOCS=true only if you need /docs in production.
# ============================================================
ENABLE_DOCS=false

# ============================================================
# OPTIONAL — Rate Limiting
# ============================================================
RATE_LIMIT_GUEST_REGISTRATION=10
RATE_LIMIT_EVENT_MEDIA_UPLOAD=30

# ============================================================
# OPTIONAL — Request Limits
# ============================================================
MAX_REQUEST_BODY_BYTES=629145600

# ============================================================
# OPTIONAL — Token Lifetimes
# ============================================================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# OPTIONAL — Login Rate Limiting
# ============================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# ============================================================
# OPTIONAL — Guest Sessions
# ============================================================
GUEST_SESSION_EXPIRE_HOURS=6

# ============================================================
# OPTIONAL — Media Limits
# ============================================================
MAX_PHOTOS_PER_EVENT=10000
MAX_VIDEOS_PER_EVENT=5000
MAX_IMAGE_SIZE_MB=30
MAX_VIDEO_SIZE_MB=500
MAX_EVENT_STORAGE_GB=50

# ============================================================
# OPTIONAL — Media Processing
# ============================================================
PROCESSING_MAX_RETRIES=3
IMAGE_OPTIMIZED_MAX_DIMENSION=2560
MAX_IMAGE_PIXELS=25000000
IMAGE_THUMBNAIL_MAX_DIMENSION=600
IMAGE_QUALITY=88
VIDEO_CRF=23
VIDEO_PRESET=medium
MAX_VIDEO_DURATION_SECONDS=1800
WORKER_CONCURRENCY=2

# ============================================================
# OPTIONAL — Automated Backups
# ============================================================
# Cron schedule for PostgreSQL backups (UTC)
BACKUP_SCHEDULE=0 2 * * *
# Days to keep backup files
BACKUP_RETENTION_DAYS=7

# ============================================================
# OPTIONAL — Docker Compose
# ============================================================
LISTEN_PORT=80
